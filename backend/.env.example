# NEXUS INTEL Backend Environment Configuration
PROJECT_NAME="NEXUS INTEL — Investigation Intelligence Platform"
API_V1_STR="/api"
ENVIRONMENT="development"

# CORS Configuration (Allowed frontend development origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Neo4j Database Configuration
# When NEO4J_URI is left empty or offline, GraphService automatically uses the built-in NetworkX graph engine
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
