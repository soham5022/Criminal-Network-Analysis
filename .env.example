# ==============================================================================
# NEXUS INTEL — Environment Configuration Template (SIH26189)
# Copy this file to .env or backend/.env and update values for your environment.
# ==============================================================================

# Frontend Configuration (Vite)
VITE_API_URL=http://127.0.0.1:8000/api

# Backend Security & JWT
JWT_SECRET_KEY=nexus_intel_sih26189_secure_random_development_key_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Neo4j Database Configuration (Optional: defaults to NetworkX in-memory fallback if unreachable)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# PostgreSQL Configuration (Optional)
DATABASE_URL=postgresql://nexus_user:nexus_password@localhost:5432/nexus_intel

# Server Host & Port
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
